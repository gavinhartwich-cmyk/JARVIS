{
  "name": "jarvis",
  "version": "0.1.0",
  "type": "module",
  "description": "JARVIS: Personal AI Operating System",
  "main": "dist/cli.js",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist",
    "test": "bun test",
    "test:live": "bun test src/**/*.test.ts",
    "db:push": "drizzle-kit push",
    "db:reset": "bun run src/db/migrations/reset.ts"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.11.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.0"
  }
}
